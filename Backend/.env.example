# ==============================================================================
# SkillVerse Backend Configuration (.env.example)
# Copy this file to .env and configure for your local environment
# ==============================================================================

NODE_ENV=development
PORT=3000

# Security (JWT secret key for token signing)
# In production, this MUST be a cryptographically secure random string of 32+ characters
JWT_SECRET=skillverse-local-development-secret-key-change-in-production

# PostgreSQL Database Configuration
# You may configure using DATABASE_URL or discrete PG* variables:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skillverse
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=skillverse
PGSSL=false

# Cross-Origin Resource Sharing (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Python FastAPI AI / ML Matching Microservice
ML_SERVICE_URL=http://127.0.0.1:8000
# Internal service token used for Node-to-FastAPI service-to-service authentication
ML_SERVICE_SECRET=skillverse-internal-service-secret-local-dev
