# ==============================================================================
# SkillVerse Root Environment Template (.env.example)
# SkillVerse - AI-Powered Skill Intelligence and Workforce Development Platform
# ==============================================================================

# Node.js Core Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=skillverse-local-development-secret-key-change-in-production

# PostgreSQL Database Configuration
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skillverse
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=skillverse
PGSSL=false

# Cross-Origin Resource Sharing
FRONTEND_ORIGIN=http://localhost:5173

# AI / ML Intelligence Microservice
ML_SERVICE_URL=http://127.0.0.1:8000
# Internal service token used for Node-to-FastAPI service-to-service authentication
ML_SERVICE_SECRET=skillverse-internal-service-secret-local-dev

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_AI_API_URL=http://127.0.0.1:8000/api/v1
